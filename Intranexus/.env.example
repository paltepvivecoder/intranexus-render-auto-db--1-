# Add these values only to a protected local environment or Manus secret input.
# Never commit a real connection string or password.
EXTERNAL_POSTGRES_URL=

# Cloud Preview is HTTPS; secure cookies are on by default. For plain HTTP local dev only,
# set COOKIE_SECURE=false (the server will use SameSite=Lax in that context).
COOKIE_SECURE=true

# Optional, only after the STI domain has been confirmed. Comma-separated institutional domains.
ALLOWED_STI_EMAIL_DOMAINS=

# Optional server upload limit; the default is 8 MiB.
MAX_UPLOAD_BYTES=8388608
